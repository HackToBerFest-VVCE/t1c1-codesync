# ======================================================================
# CodeSync - Gemma 4 Circuit Doctor Environment Configuration
# ======================================================================
# COPY THIS FILE TO .env AND POPULATE WITH YOUR ACTUAL CONFIGURATION.
# NEVER COMMIT .env TO VERSION CONTROL.
# ======================================================================

# Google GenAI / Gemma API Key
GEMINI_API_KEY=your_api_key_here

# Exact Model Identifier for Gemma 4 Reasoning Engine
# Set to your verified Gemma 4 model identifier provided for the hackathon
GEMMA_MODEL=your_verified_model_identifier_here

# Optional: Custom API Base URL if using a dedicated hackathon endpoint or self-hosted Gemma 4
# GEMMA_API_BASE=https://your-custom-gemma-endpoint.example.com

# Optional: Secondary Beginner Simplification Layer (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=your_verified_openai_model_here
